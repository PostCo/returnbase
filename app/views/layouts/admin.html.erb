<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= yield :title %> | Returnbase admin</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font: 13px/18px -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; color: #18181b; background: #fff; }
    .bar { display: flex; align-items: center; gap: 12px; height: 40px; padding: 0 16px; background: #18181b; color: #e4e4e7; font-size: 12px; }
    .bar .tag { padding: 2px 8px; border-radius: 3px; background: #dc2626; color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
    .bar .aside { margin-left: auto; color: #a1a1aa; }
    main { padding: 12px 16px 32px; }
    .crumb { margin-bottom: 8px; color: #71717a; font-size: 12px; }
    h1 { margin: 0 0 4px; font-size: 18px; line-height: 24px; }
    .lede { max-width: 760px; margin: 0 0 12px; color: #52525b; }
    .notice { display: inline-block; margin: 0 0 12px; padding: 4px 10px; border-left: 3px solid #18181b; background: #f4f4f5; }
    .scroll { overflow-x: auto; }
    table { width: 100%; max-width: 1100px; border-collapse: collapse; }
    th, td { padding: 5px 8px; border: 1px solid #d4d4d8; text-align: left; vertical-align: middle; }
    th { background: #f4f4f5; font-size: 12px; font-weight: 600; white-space: nowrap; }
    tbody tr:nth-child(even) td { background: #fafafa; }
    td small { display: block; color: #71717a; font: 11px ui-monospace, Menlo, monospace; }
    input[type=text], input[type=password], select { width: 100%; min-width: 160px; height: 28px; padding: 0 6px; border: 1px solid #a1a1aa; border-radius: 3px; background: #fff; font: 12px ui-monospace, Menlo, monospace; }
    input[type=checkbox] { width: 16px; height: 16px; margin: 0; }
    td.center { text-align: center; }
    .pill { padding: 1px 6px; border-radius: 3px; background: #e4e4e7; font: 11px/16px ui-monospace, Menlo, monospace; white-space: nowrap; }
    .pill.enabled { background: #dcfce7; color: #166534; }
    button { height: 28px; padding: 0 12px; border: 1px solid #18181b; border-radius: 3px; background: #18181b; color: #fff; font: inherit; font-size: 12px; cursor: pointer; }
    :focus-visible { outline: 2px solid #2563eb; outline-offset: 1px; }
    @media (max-width: 760px) { .bar .aside { display: none; } }
  </style>
</head>
<body>
  <div class="bar"><b>Returnbase admin</b><span class="tag">Support, internal</span><span class="aside">Not visible to merchants</span></div>
  <main>
    <%= yield %>
  </main>
</body>
</html>
