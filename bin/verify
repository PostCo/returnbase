#!/usr/bin/env bash
# Checks every service, the web proxy, the Rails tests and the web typecheck.
set -euo pipefail
cd "$(dirname "$0")/.."

fail() {
  echo "FAIL: $*" >&2
  echo "Look at: docker compose ps, then docker compose logs <service>" >&2
  exit 1
}

for service in db api worker web vendors shipping mailpit; do
  container=$(docker compose ps -q "$service")
  status=$([ -n "$container" ] && docker inspect --format '{{.State.Health.Status}}' "$container" || true)
  [ "$status" = "healthy" ] || fail "$service is not healthy (status: ${status:-not running})"
  echo "ok  $service is healthy"
done

check_url() {
  curl -fsS "$2" | grep -q "$3" || fail "$1 did not answer as expected at $2"
  echo "ok  $1 answers at $2"
}
check_url "api" http://localhost:3100/api/health '"status":"ok"'
check_url "api through the web proxy" http://localhost:5180/api/health '"status":"ok"'
check_url "vendors" http://localhost:4100/health '"status":"ok"'
check_url "shipping" http://localhost:4300/health '"status":"ok"'
check_url "mailpit" http://localhost:8125/api/v1/info 'Version'

docker compose exec -T api bin/rails test || fail "Rails tests failed"
docker compose exec -T web npm run typecheck || fail "web typecheck failed"

code=$(git rev-parse --short=6 HEAD 2>/dev/null || echo "000000")
echo "Setup verified. Your code: RB-$code"
